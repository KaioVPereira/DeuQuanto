{
  "name": "deu-quanto",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "mobile:sync": "npm run build && cap sync android",
    "apk": "npm run mobile:sync && cd android && .\\gradlew.bat assembleDebug",
    "apk:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
